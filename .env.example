# ---------------------------------------------------------------------------
# Ratshie (Pty) Ltd - environment configuration example
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit your real `.env` file.
# ---------------------------------------------------------------------------

# Core Django
# Generate a real key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string-50+chars
# cPanel: set the RATSHIE_ENV system environment variable to "prod" to select
# production settings (RATSHIE_ENV is read from the OS env, not this file).
DEBUG=False
ALLOWED_HOSTS=ratshie.co.za,www.ratshie.co.za,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://ratshie.co.za,https://www.ratshie.co.za,http://127.0.0.1:8000

# Database (leave empty to use SQLite locally; set for production)
# Example PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Business contact details (from official business summary)
BUSINESS_PHONE=+27614884254
BUSINESS_PHONE_DISPLAY=061 488 4254
BUSINESS_EMAIL=admin@ratshie.co.za
WHATSAPP_NUMBER=27659017566
WHATSAPP_DISPLAY=065 901 7566
CONTACT_NAME=Livhuwani
BUSINESS_ADDRESS=Seoding Village, Kuruman, Northern Cape, South Africa
SERVICE_RADIUS_KM=50

# Cart / checkout behaviour
# ENABLE_CART=True enables the enquiry-based cart. Products without a set price
# remain "Request a Quote" and no fake prices are shown.
ENABLE_CART=True

# PayFast - sandbox by default. Use real merchant credentials in production.
PAYFAST_SANDBOX=True
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Base URL used for return/cancel/notify URLs (set to your domain in prod)
PAYFAST_RETURN_URL_PREFIX=https://ratshie.co.za

# Email (cPanel SMTP on ratshie.co.za, SSL port 465)
EMAIL_HOST=ratshie.co.za
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=admin@ratshie.co.za
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=admin@ratshie.co.za
ADMIN_EMAIL=admin@ratshie.co.za
SERVER_EMAIL=admin@ratshie.co.za

# Production (optional hardening)
# SECURE_SSL_REDIRECT=True